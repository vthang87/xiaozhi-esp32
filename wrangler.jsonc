// Cloudflare Workers config — serves the XiaoZhi web installer as static assets.
// Firmware is compiled by GitHub Actions (espressif/idf) then this Worker is
// deployed with wrangler. Create Worker `xiaozhi-install` in the Cloudflare
// dashboard once; do not use Cloudflare's Git build (it cannot run ESP-IDF).
// Repo secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
{
  "name": "xiaozhi-install",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./web/installer"
  }
}
