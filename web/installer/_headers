# Firmware binaries for ESP Web Tools.
/firmware/*/*.bin
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=60

/firmware/*/ready.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60

/boards.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60

/boards/*
  Cache-Control: public, max-age=86400

/manifest.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60

/version.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60

/
  Cache-Control: public, max-age=60
